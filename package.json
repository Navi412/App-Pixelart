{
  "name": "pixel-editor",
  "version": "1.0.0",
  "description": "Editor de píxel art con animación por fotogramas",
  "author": "ivanm",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ivanm.pixeleditor",
    "productName": "Editor de Pixel Art",
    "asar": false,
    "files": [
      "**/*",
      "!tests/**/*",
      "!build/icon.png",
      "!*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
